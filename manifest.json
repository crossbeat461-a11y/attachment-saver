{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "ja",
  "version": "6.7",
  "author": "K-Tech-Studio",
  "browser_specific_settings": {
    "gecko": {
      "id": "K-saver@k-tech-studio.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "messagesRead",
    "downloads",
    "menus"
